# API Keys
export SERPAPI_API_KEY=xxx
export SERPER_DEV_API_KEY=xxx  # Optional alternative to SERPAPI
export JINA_API_KEY=xxx        # Optional, default is None
export OPENAI_API_KEY=xxx      # Required for benchmark evaluation (LLM-judge scoring)

# Weights & Biases (optional)
# export WANDB_MODE=disabled  # Set to disable wandb logging

